# macOS metadata
.DS_Store
._*
.AppleDouble
.LSOverride

# Xcode build products and caches
/build/
/DerivedData/
*.app/
*.dSYM/
*.dSYM.zip
*.xcarchive/
*.xcresult/

# Xcode per-user settings (keep shared schemes and workspace contents)
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3

# Signing keys, certificates, provisioning profiles, and local keychains
*.p8
*.p12
*.pfx
*.pem
*.key
*.cer
*.crt
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# Local credentials and environment overrides (keep safe examples trackable)
.env
.env.*
!.env.example
!.env.template
.netrc
/.aws/
/.ssh/
/credentials/
/secrets/

# Historical release/source archives
/Image2Movie*.zip

# Generated by Matlab_Animation_Example.m
/Animation_Example_Frames/

# Movie exports
*.mov
*.mp4
*.m4v
