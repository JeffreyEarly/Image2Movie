<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="23077" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none">
    <dependencies>
        <deployment identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="23077"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="NSApplication">
            <connections>
                <outlet property="delegate" destination="app-delegate" id="delegate-connection"/>
                <outlet property="mainMenu" destination="main-menu" id="main-menu-connection"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application">
            <connections>
                <outlet property="servicesMenu" destination="services-menu" id="services-connection"/>
                <outlet property="windowsMenu" destination="window-menu" id="windows-connection"/>
            </connections>
        </customObject>
        <customObject id="app-delegate" customClass="AppController"/>
        <menu title="Main Menu" systemMenu="main" id="main-menu">
            <items>
                <menuItem title="Image2Movie" id="app-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Image2Movie" systemMenu="apple" id="app-menu">
                        <items>
                            <menuItem title="About Image2Movie" id="about-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections><action selector="orderFrontStandardAboutPanel:" target="-1" id="about-action"/></connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-separator-1"/>
                            <menuItem title="Services" id="services-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <menu key="submenu" title="Services" systemMenu="services" id="services-menu"/>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-separator-2"/>
                            <menuItem title="Hide Image2Movie" keyEquivalent="h" id="hide-item">
                                <connections><action selector="hide:" target="-1" id="hide-action"/></connections>
                            </menuItem>
                            <menuItem title="Hide Others" keyEquivalent="h" id="hide-others-item">
                                <modifierMask key="keyEquivalentModifierMask" option="YES" command="YES"/>
                                <connections><action selector="hideOtherApplications:" target="-1" id="hide-others-action"/></connections>
                            </menuItem>
                            <menuItem title="Show All" id="show-all-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections><action selector="unhideAllApplications:" target="-1" id="show-all-action"/></connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="app-separator-3"/>
                            <menuItem title="Quit Image2Movie" keyEquivalent="q" id="quit-item">
                                <connections><action selector="terminate:" target="-1" id="quit-action"/></connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="File" id="file-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="File" id="file-menu">
                        <items>
                            <menuItem title="Add Images…" keyEquivalent="o" id="add-images-item">
                                <connections><action selector="openImageFilesAction:" target="-1" id="add-images-action"/></connections>
                            </menuItem>
                            <menuItem title="Export Movie…" keyEquivalent="s" id="export-movie-item">
                                <connections><action selector="exportMovie:" target="-1" id="export-movie-action"/></connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="file-separator"/>
                            <menuItem title="Close" keyEquivalent="w" id="close-item">
                                <connections><action selector="performClose:" target="-1" id="close-action"/></connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Edit" id="edit-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Edit" id="edit-menu">
                        <items>
                            <menuItem title="Undo" keyEquivalent="z" id="undo-item">
                                <connections><action selector="undo:" target="-1" id="undo-action"/></connections>
                            </menuItem>
                            <menuItem title="Redo" keyEquivalent="Z" id="redo-item">
                                <connections><action selector="redo:" target="-1" id="redo-action"/></connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="edit-separator"/>
                            <menuItem title="Cut" keyEquivalent="x" id="cut-item">
                                <connections><action selector="cut:" target="-1" id="cut-action"/></connections>
                            </menuItem>
                            <menuItem title="Copy" keyEquivalent="c" id="copy-item">
                                <connections><action selector="copy:" target="-1" id="copy-action"/></connections>
                            </menuItem>
                            <menuItem title="Paste" keyEquivalent="v" id="paste-item">
                                <connections><action selector="paste:" target="-1" id="paste-action"/></connections>
                            </menuItem>
                            <menuItem title="Delete" id="delete-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections><action selector="delete:" target="-1" id="delete-action"/></connections>
                            </menuItem>
                            <menuItem title="Select All" keyEquivalent="a" id="select-all-item">
                                <connections><action selector="selectAll:" target="-1" id="select-all-action"/></connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
                <menuItem title="Window" id="window-menu-item">
                    <modifierMask key="keyEquivalentModifierMask"/>
                    <menu key="submenu" title="Window" systemMenu="window" id="window-menu">
                        <items>
                            <menuItem title="Minimize" keyEquivalent="m" id="minimize-item">
                                <connections><action selector="performMiniaturize:" target="-1" id="minimize-action"/></connections>
                            </menuItem>
                            <menuItem title="Zoom" id="zoom-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections><action selector="performZoom:" target="-1" id="zoom-action"/></connections>
                            </menuItem>
                            <menuItem isSeparatorItem="YES" id="window-separator"/>
                            <menuItem title="Bring All to Front" id="bring-all-item">
                                <modifierMask key="keyEquivalentModifierMask"/>
                                <connections><action selector="arrangeInFront:" target="-1" id="bring-all-action"/></connections>
                            </menuItem>
                        </items>
                    </menu>
                </menuItem>
            </items>
        </menu>
    </objects>
</document>
